# Settings the API reads from environment variables (see config.py).
# Names only - never commit real values. On the server they live in
# /etc/nextjob/nextjob.env, which only root can read.
SECRET_KEY=
DB_HOST=localhost
DB_NAME=nextjob
DB_USER=nextjob_api
DB_PASSWORD=
UPLOAD_FOLDER=
FRONTEND_URL=http://localhost:5173
# optional - without them, mails are written to the log instead of sent

# NextJob - SMTP2GO

SMTP_HOST=mail-eu.smtp2go.com
SMTP_PORT=587
SMTP_USER=nextjob-mail
SMTP_PASSWORD=YOUR_SMTP_PASSWORD
MAIL_FROM="NextJob <edosha20@htl-shkoder.com>"

# Frontend URL - replace with deployed frontend address
FRONTEND_URL=https://YOUR_FRONTEND_DOMAIN
